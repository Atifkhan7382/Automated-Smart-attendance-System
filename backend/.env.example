# Backend Environment Variables for Deployment

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Python Version
PYTHON_VERSION=3.11

# Database (SQLite - no config needed for Railway/Render)
# Path will be: /app/data/attendance.db

# CORS Settings (Update with your frontend URL)
FRONTEND_URL=https://your-frontend-url.railway.app

# Optional: External Storage (for production)
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_BUCKET_NAME=attendance-images

# Optional: Email Notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASSWORD=your_password
