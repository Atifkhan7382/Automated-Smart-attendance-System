# Production Environment Configuration

# Application Settings
APP_NAME=Smart Attendance System
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Database Configuration (Use PostgreSQL in production)
DATABASE_URL=postgresql://username:password@db:5432/smart_attendance

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Frontend Configuration
REACT_APP_API_URL=https://your-domain.com/api
REACT_APP_TITLE=Smart Attendance System

# Security Settings (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING
JWT_SECRET_KEY=CHANGE-THIS-TO-A-SECURE-JWT-SECRET
CORS_ORIGINS=https://your-domain.com

# SSL/TLS Settings
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Performance Settings
FACE_RECOGNITION_TOLERANCE=0.45
NUM_JITTERS=3
ENABLE_GPU_ACCELERATION=true

# Monitoring
LOG_LEVEL=WARNING
SENTRY_DSN=your-sentry-dsn-here

# Backup Settings
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
